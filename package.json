{
  "name": "@webfeet/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/barrel/*",
    "packages/event-handler/*",
    "packages/reflect/*"
  ],
  "scripts": {
    "format": "prettier -w .",
    "lint": "prettier -l . && eslint . && tsc"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.0",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@web/dev-server-rollup": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-package-json": "^1.8.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tstyche": "^7.2.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "@changesets/cli": {
      "@babel/runtime": "$@babel/eslint-parser"
    },
    "@rollup/plugin-babel": {
      "@babel/core": "$@babel/eslint-parser",
      "@babel/helper-module-imports": "$@babel/eslint-parser"
    },
    "@web/test-runner": {
      "@babel/code-frame": "$@babel/eslint-parser"
    }
  }
}
